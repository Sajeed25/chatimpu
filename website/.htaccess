# Chatimpu public website (www.chatimpu.com) on Hostinger.
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php
RewriteEngine On

# HTTPS and www (chatimpu.com → www.chatimpu.com)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^chatimpu\.com$ [NC]
RewriteRule ^ https://www.chatimpu.com%{REQUEST_URI} [L,R=301]

# Settings and helpers are never served
RewriteRule ^_ - [F,L]
RewriteRule ^(README\.md|\.git) - [F,L]

# Shared links from the app
RewriteRule ^s/v/([A-Za-z0-9_-]+)/?$ story.php?v=$1 [L,QSA]
RewriteRule ^s/([A-Za-z0-9_-]+)/?$ story.php?id=$1 [L,QSA]

# Clean addresses: /privacy → privacy.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(png|jpg|webp|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
